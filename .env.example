# ChatOS 环境变量模板
# 复制为 .env 并填入真实值；.env* 已被 gitignore，绝不提交。
# 注意：数据库路径、webDist 等走 apps/gateway/config/settings.json，不在这里。

# ── LLM（OpenAI 兼容中继）────────────────────────────────────────
# 鉴权 key（二选一；当前代码读取 APIYI_API_KEY 或 CC_APIYI_KEY）
APIYI_API_KEY=
# CC_APIYI_KEY=

# 中继地址与模型
CC_LLM_BASE_URL=https://api.apiyi.com/v1
CC_LLM_MODEL=claude-haiku-4-5-20251001

# 预留：远程调用超时（秒）。当前代码硬编码 20s，接线后生效
# CC_LLM_TIMEOUT=20

# 预留：其它可选中继/模型 key（尚未接线，占位）
# CC_DEEPSEEK_KEY=
# ARK_API_KEY=

# ── 运行端口 ────────────────────────────────────────────────────
# serve 用 --port 8912 传入；此处仅作文档记录
# PORT=8912
