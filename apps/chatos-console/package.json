{
  "name": "chatos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node ../../scripts/verify-entry.mjs && node dist/server.cjs --production",
    "typecheck": "tsc --noEmit",
    "test": "node --test ../../tests/canonical-entry.test.mjs scripts/message-loading.test.mjs scripts/gateway-proxy.test.mjs && node scripts/verify-ui-baseline.mjs && npm run verify:features",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:features": "node --experimental-strip-types scripts/verify-conversation-features.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
